# Required. Supply through the deployment secret manager; never commit real values.
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=
# Optional branded sender; defaults to the configured SMTP user.
EMAIL_FROM=
# Optional custom SMTP relay. Leave host empty to use Gmail service configuration.
SMTP_HOST=
SMTP_PORT=587
# Use a shared edge rate limit for multi-instance deployments. Overwrite forwarded IP headers.
# Public origin of the confirmed Viaferra deployment, used for sitemap URLs.
SITE_URL=
